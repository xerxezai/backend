# Copy this file to .env and fill in real values. Never commit .env itself.

# Django
DJANGO_ENV=development
DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here

# Database
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
# Alternative to the DB_* vars above (Railway/Heroku style) — set one or the other.
DATABASE_URL=

# JWT
JWT_SECRET_KEY=your-jwt-secret

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email-user
EMAIL_PASSWORD=your-email-password
CONTACT_ADMIN_EMAIL=info@example.com
CONTACT_FROM_EMAIL=info@example.com

# Razorpay (LMA course payments)
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here

# Cache
REDIS_URL=redis://localhost:6379/0

# AWS S3 (optional file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_REGION=us-east-1
STORAGE_BACKEND=local

# CORS / hosts
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=True
FRONTEND_URL=http://localhost:5173

# AI
GROQ_API_KEY=your-groq-api-key
